                      <div>
                        {/* name */}
                        <div className="font-semibold text-slate-800 text-sm">
                          {r.name}
                        </div>
                        {/* role */}
                        <div className="text-xs text-slate-400">{r.role}</div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      )}

      {/* ════════════════════════════════════════════════
          SECTION 7 — MATRICS (metric cards)
          Strapi fields used:
            Matrics[i].heading1  → big value e.g. "18%"
            Matrics[i].subHeading → label e.g. "Average savings"
            Matrics[i].subText   → sublabel e.g. "vs. traditional"
      ════════════════════════════════════════════════ */}
      {Matrics?.length > 0 && (
        <section className="py-16 bg-white">
