                    {/* Static 5 stars */}
                    <div className="flex gap-0.5 mb-5">
                      {[...Array(5)].map((_, s) => (
                        <Star
                          key={s}
                          className="w-4 h-4 fill-amber-400 text-amber-400"
                        />
                      ))}
                    </div>
                    {/* comment */}
                    <p className="text-slate-600 font-light leading-relaxed mb-6 italic text-sm">
                      "{r.comment}"
